{
  "name": "@wiwo/tippyjs",
  "version": "6.3.7",
  "description": "The complete tooltip, popover, dropdown, and menu solution for the web",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "author": "atomiks",
  "contributors": [
    "Brett Zamir"
  ],
  "license": "MIT",
  "bugs": "https://github.com/atomiks/tippyjs/issues",
  "homepage": "https://atomiks.github.io/tippyjs/",
  "keywords": [
    "tooltip",
    "popover",
    "popper",
    "dropdown",
    "popup",
    "tippy",
    "tippy.js"
  ],
  "files": [
    "dist/",
    "animations/",
    "themes/",
    "headless/",
    "index.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atomiks/tippyjs.git"
  },
  "scripts": {
    "build": "npm run build:sass && npm run tsc",
    "build:visual": "cross-env NODE_ENV=test rollup -c .config/rollup.config.js",
    "build:sass": "sass ./src/scss/index.scss ./dist/tippy.css",
    "serve": "serve test/visual",
    "xtest:dom": "jest unit integration --coverage",
    "xtest:functional": "jest functional",
    "xtest:types": "tsc && tsd",
    "xtest": "yarn test:types && yarn test:dom && yarn test:functional",
    "clean": "rimraf dist/ themes/ animations/ coverage/",
    "prepare": "yarn clean && yarn build",
    "tsc": "tsc --project ./tsconfig.json"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "sass-embedded": "^1.105.1",
    "serve": "^14.2.6",
    "tsd": "^0.14.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@popperjs/core": "file://../popper-core"
  },
  "disabledDependencies": {
    "@popperjs/core": "^2.9.0"
  }
}
